{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cleanup and rebuild",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "package"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }, {
      "label": "Build and run the demo application",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "spring-boot:run"],
      "group": {
        "kind": "build"
      }
    }
  ]
}

